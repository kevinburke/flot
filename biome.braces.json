{
	"$schema": "https://biomejs.dev/schemas/2.5.6/schema.json",
	"files": {
		"includes": ["**/*.{js,mjs,cjs,ts,tsx}", "!**/dist", "!**/node_modules", "!examples/shared"]
	},
	"formatter": { "enabled": false },
	"linter": {
		"enabled": true,
		"rules": {
			"preset": "none",
			"style": { "useBlockStatements": "error" }
		}
	}
}
